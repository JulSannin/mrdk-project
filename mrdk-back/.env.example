# Скопируйте в .env и заполните значениями. .env в репозиторий НЕ коммитится.

NODE_ENV=development
PORT=3001

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/mrdk
POSTGRES_PASSWORD=

# Длинная случайная строка, напр. `openssl rand -base64 64`.
# ⚠️ Только для локальной разработки: в docker-режиме JWT_SECRET в корневой .env
# НЕ пишется — он лежит файлом secrets/jwt_secret (compose передаёт JWT_SECRET_FILE).
JWT_SECRET=

# Список разрешённых origin фронтенда через запятую (без хвостовой запятой)
CLIENT_ORIGIN=http://localhost:5173
GOSUSLUGI_ORIGIN=https://gosuslugi.ru

# База для ссылок в sitemap.xml (в dev не нужна; в проде задаётся в корневом .env,
# по умолчанию https://nn-lance.ru)
# SITE_ORIGIN=https://nn-lance.ru

# Учётка администратора. Пароль нужен ТОЛЬКО при первом старте на пустой БД
# (для создания админа); дальше сервер стартует и без него.
ADMIN_LOGIN=
# Путь к файлу с паролем (имеет приоритет над ADMIN_PASSWORD):
#   dev:  ../secrets/admin_password (общий с docker-compose секрет)
#   prod: /run/secrets/admin_password (docker secret, задаётся в compose)
ADMIN_PASSWORD_FILE=../secrets/admin_password
# Либо паролем напрямую (не рекомендуется):
# ADMIN_PASSWORD=

# SMTP для формы обратной связи. Прод ходит через mail.ru: smtp.mail.ru:465 + SECURE=true.
# Проверка настроек: cd mrdk-back && node smtp-test.mjs
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
# Пароль — тоже только для dev: в docker-режиме лежит файлом secrets/smtp_pass.
# ⚠️ Для mail.ru это «пароль для внешних приложений» из настроек ящика, а НЕ пароль
# от почты — с обычным паролём аутентификация молча не проходит и форма не отправляется.
# ⚠️ Часть VPN режет порты 25/465/587: тогда smtp-test.mjs падает по таймауту из-за
# сети, а не из-за конфигурации — проверяй с прямого IP.
SMTP_PASS=
ADMIN_EMAIL=admin@example.com
